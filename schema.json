{
	"$schema": "https://json-schema.org/draft-07/schema#",
	"$id": "http://static.arkevorkhat.net/schemas/nyzul/layout.schema.json",
	"definitions": {
		"NyzulNode": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"description": "a valid HTML tag name"
				},
				"id": {
					"type": "string",
					"description": "a valid HTML element ID"
				},
				"classes": {
					"type": "array",
					"items": {
						"type": "string",
						"description": "CSS classes for the element"
					}
				},
				"innerText": {
					"type": "string",
					"description": "the text content of the element"
				},
				"attributes": {
					"type": "object",
					"description": "a mapping of attribute names and values."
				},
				"children": {
					"type":"array",
					"items": {
						"$ref": "#/definitions/NyzulNode"
					}
				}
			}
		}
	}
}